# 이 파일을 .env 로 복사한 뒤 키를 넣으세요. (https://platform.claude.com 에서 발급)
ANTHROPIC_API_KEY=

# 일러스트를 GPT 이미지로 생성할 때 필요 (https://platform.openai.com 에서 발급)
OPENAI_API_KEY=
# (GPU 없는 VM) 받아쓰기도 위 OPENAI_API_KEY 로 Whisper API 를 씀 — 분당 약 0.006달러

# 구글 드라이브 (클라우드 VM 처럼 브라우저 로그인이 안 될 때). 둘 중 하나만.
# 1) 서비스 계정 JSON 키 내용을 한 줄로. 드라이브 입력·Output 폴더를 서비스 계정 이메일에 '편집자'로 공유.
GOOGLE_SERVICE_ACCOUNT_JSON=
# 2) 내 계정 OAuth (개인 @gmail 드라이브에서 서비스 계정 용량 오류가 날 때)
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=
